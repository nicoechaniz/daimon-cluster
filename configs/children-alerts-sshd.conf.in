Port 2223
ListenAddress @VPN_ADDRESS@
HostKey /etc/children-alerts-link/server
PidFile /run/children-alerts-link/sshd.pid
AuthorizedKeysFile /etc/children-alerts-link/client.pub
AllowUsers cluster-alerts-link
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
PubkeyAuthentication yes
StrictModes yes
UsePAM no
UseDNS no
AllowTcpForwarding remote
PermitListen 127.0.0.1:8796
AllowStreamLocalForwarding no
PermitTTY no
PermitTunnel no
AllowAgentForwarding no
X11Forwarding no
ForceCommand /usr/sbin/nologin
LogLevel ERROR
