# restic-backup.service + .timer — daily local encrypted backup (issue #15)
# Install: sudo cp configs/restic-backup.{service,timer} /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now restic-backup.timer
[Unit]
Description=daimon-cluster restic backup (local repo; legion pulls off-host copy)
After=incus.service

[Service]
Type=oneshot
User=root
Environment=RESTIC_PASSWORD_FILE=/var/lib/daimon-cluster/backup-keys/restic-password
ExecStart=/opt/daimon-cluster/scripts/restic-backup.sh
Nice=19
IOSchedulingClass=idle
