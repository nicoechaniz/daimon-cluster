[Unit]
Description=Observe daily reviewed package maintenance in four existing guests
After=network-online.target incus.service
Wants=network-online.target
RequiresMountsFor=/var/lib/children-maintenance/packages

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B -I /opt/children-maintenance/package-selected/children_package_maintenance.py --fleet --with-brotli --state /var/lib/children-maintenance/packages
Environment=INCUS_CONF=/run/children-packages/incus
RuntimeDirectory=children-packages
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=900
TimeoutStopSec=15
MemoryMax=128M
CPUQuota=25%
TasksMax=32
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/children-maintenance/packages
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=null
StandardError=journal
