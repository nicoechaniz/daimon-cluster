[Unit]
Description=Own companion private virtual browser display
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
UMask=0077
ExecStart=/usr/bin/Xvfb :77 -screen 0 1280x800x24 -nolisten tcp -auth %h/.kimi-webbridge/Xauthority
Restart=on-failure
RestartSec=5
MemoryMax=128M
TasksMax=32
CPUQuota=25%
TimeoutStopSec=15
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=100
